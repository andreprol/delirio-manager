# Copiar para .env e preencher. O .env NAO vai para o git (.gitignore).
#
# Se este arquivo sumir, o pipeline para inteiro: em 22/08/2026 um `git rm` sem
# --cached apagou o .env do disco, o slot Generate morreu sem REPLICATE_API_TOKEN
# e o alerta por e-mail tambem nao saiu, porque a RESEND_API_KEY estava no mesmo
# arquivo. O canal ficou mudo sem ninguem saber.

# Obrigatoria no slot `generate` — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# Obrigatoria nos alertas de todo slot — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_key_here

# Obrigatorio no slot `upload` — OAuth client do Google Cloud (arquivo tem que existir)
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json

DB_PATH=data/pipeline.db
TEMP_DIR=data/temp
AUDIO_PENDING_DIR=data/audio/pending
AUDIO_USED_DIR=data/audio/used
