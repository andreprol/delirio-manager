# Migracao SQLite -> Postgres (Delirio Manager). Nao commitar valores reais
# aqui -- isso e so o exemplo. Credenciais reais ficam em F:\RichClub\.secrets\
# (gitignored), ex: .secrets/postgres-dev.env.
#
# Rodar migracoes:
#   cd server
#   set -a && source ../.secrets/postgres-dev.env && set +a   # (git bash)
#   npm run migrate:up      # aplica todas as migracoes pendentes
#   npm run migrate:down    # desfaz a ultima
#   npm run migrate:create nome_da_migracao   # cria um novo arquivo .sql

DATABASE_URL=postgresql://usuario:senha@host.postgres.database.azure.com/postgres?sslmode=require
